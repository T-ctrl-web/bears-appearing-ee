  "fast_path": {
    "enabled": true,
    "rules": {
      "simple": "总裁直接处理，不派 Worker",
      "threshold": "改文案/修拼写/改配置 等单点修改",
      "complexity_eval": {
        "simple": { "criteria": "单文件单点修改", "action": "总裁直干", "verifier": "无" },
        "medium": { "criteria": "单模块开发/2-4步", "action": "拆解派发", "verifier": "Level 1 吉吉国王" },
        "complex": { "criteria": "跨模块/5+步", "action": "拆解+并行派发", "verifier": "Level 2 老鳄+小狸" }
      }
    }
  },

  "parallel": {
    "enabled": true,
    "strategy": "独立子任务并行派发，有依赖的顺序执行",
    "max_concurrent": 3,
    "note": "Phase 2 支持局部并行，最多同时 3 个 subagent"
  },

  "task_state_machine": {
    "states": ["待处理", "已拆解", "执行中", "并行执行中", "待验证", "验证驳回", "完成", "失败", "已暂停"],
    "transitions": {
      "待处理→已拆解": "Leader 完成任务拆解",
      "已拆解→执行中": "Leader 顺序派发 Worker",
      "已拆解→并行执行中": "Leader 并行派发独立子任务",
      "执行中→待验证": "Worker 完成产出",
      "并行执行中→待验证": "全部并行 Worker 完成",
      "待验证→完成": "Verifier 审查通过",
      "待验证→验证驳回": "Verifier 驳回",
      "验证驳回→执行中": "Leader 重新派发（迭代+1）",
      "执行中→已暂停": "成本超限",
      "已暂停→执行中": "用户追加预算",
      "执行中→失败": "重试耗尽，升级用户"
    }
  },

  "priority_queue": {
    "levels": {
      "P0": { "name": "紧急", "action": "立即插队执行，暂停其他任务", "examples": "线上故障/安全漏洞" },
      "P1": { "name": "常规", "action": "正常排队执行", "examples": "功能开发/Bug修复" },
      "P2": { "name": "后台", "action": "空闲时执行，不阻塞P1", "examples": "文档优化/技术债" }
    }
  },

  "complexity_evaluator": {
    "dimensions": ["文件数", "模块数", "依赖关系", "技术栈数量", "安全敏感度"],
    "rules": {
      "simple": "文件数<=1 且 模块数<=1 且 无安全敏感",
      "medium": "文件数2-5 或 模块数<=2",
      "complex": "文件数>5 或 模块数>2 或 安全敏感 或 跨系统"
    },
    "verifier_mapping": {
      "simple": null,
      "medium": "level_1",
      "complex": "level_2"
    }
  }
}
