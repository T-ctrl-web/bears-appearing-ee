{
  "name": "bears-appearing-ee-desktop",
  "version": "1.0.0",
  "author": "Bears Group",
  "description": "熊出没集团 · 纸片人工作看板 桌面版（Electron 壳，复用零依赖 node server）",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "predist": "node copy-assets.js",
    "dist": "node node_modules/electron-builder/out/cli/cli.js --win",
    "build:dir": "node copy-assets.js && node node_modules/electron-builder/out/cli/cli.js --win --dir"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bears.ee.desktop",
    "productName": "熊出没集团",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "build-app/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  }
}